# Copy to .env and fill in. Never commit .env.

APP_ENV=development            # development | production
SITE_NAME=YourName

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored customer data unreadable. Back it up safely.
PII_ENCRYPTION_KEY=

DATABASE_URL=postgresql://camper:camper@127.0.0.1:5442/camper
FRONTEND_URL=http://localhost:3210

# Stripe. Leave blank in development to use mock payments (bookings confirm instantly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gmail: use an app password (Google Account > Security > App passwords).
# Leave blank in development to skip sending emails.
SMTP_USERNAME=
SMTP_PASSWORD=
OWNER_EMAIL=

DEPOSIT_PERCENT=30
LICENSE_RETENTION_DAYS=30
